{
  // Static assets only. Build first: npm run build
  "name": "bubo-site",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "bubo.weekndlabs.com/*", "zone_name": "weekndlabs.com" }]
}
