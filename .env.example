# Copy to .env for local work, and set the same names in the Vercel project.
# .env is gitignored; none of these belong in the repo.

# Clerk — identity only. The publishable key is public by design and ships to
# the browser; the secret key must never be read from client code.
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The store (merchant of record). It owns checkout, VAT and the license keys;
# the webhook secret is what proves an order callback really came from them.
STORE_WEBHOOK_SECRET=
STORE_API_KEY=
STORE_CHECKOUT_URL=
