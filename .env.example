# Copy to .env for local work, and set the same names in the Vercel project.
# .env is gitignored; none of these belong in the repo.

# --- Clerk: identity only -----------------------------------------------------
# The publishable key is public by design and ships to the browser. The secret
# key must never be read from client code.
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Paddle: checkout, tax, receipts ------------------------------------------
# Paddle Billing is the merchant of record, so it sells to the customer and
# handles VAT. Confirm these names against the Paddle dashboard before wiring
# them up; they are written from Paddle's own vocabulary of API key, client-side
# token and webhook secret, not copied out of a working project.
#
# Sandbox first: PUBLIC_PADDLE_ENV=sandbox until a real purchase is tested.
PUBLIC_PADDLE_ENV=sandbox
PUBLIC_PADDLE_CLIENT_TOKEN=
PUBLIC_PADDLE_PRICE_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- License keys --------------------------------------------------------------
# Paddle Billing has no license-key feature, unlike Lemon Squeezy and Polar, so
# Bubo issues its own on `transaction.completed` and the Mac app validates them
# against this site. LICENSE_SIGNING_SECRET signs the key so a forged one fails
# without a database round trip.
LICENSE_SIGNING_SECRET=
