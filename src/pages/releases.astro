---
import '../styles/tokens.css';

// Only the newest entry carries a download button, and it goes to the account,
// which lists the builds once someone is signed in.
const app = 'https://app.bubo.weekndlabs.com';

// The real releases, newest first. One sentence on what the version is for, then
// the few changes someone would notice. Short on purpose: this page answers "what
// is new and should I update", and the long form of each line did not help.
const releases = [
  {
    v: '1.5',
    date: '13 Oct 2026',
    latest: true,
    lede: 'Bubo names the right app, and the panel is easier to read.',
    changes: [
      'Storage: used and free space on your startup disk',
      'Helper processes count under the app that owns them',
      'Darker labels that read in light mode',
      'Quit and Activity Monitor stay on screen on small displays',
      'Pro: licence activation, seven days of history, day and week charts',
    ],
    download: true,
  },
  {
    v: '1.4',
    date: '28 Jul 2026',
    lede: 'The panel opens flat under the menu bar, as tall as your screen allows.',
    changes: [
      'Check for Updates and Report a bug in the right-click menu',
      'A bar per core in the efficiency and performance rows',
      'Fan speed shown against its floor and ceiling',
      'Power rails split by rail, next to battery',
    ],
  },
  {
    v: '1.3',
    date: '27 Jul 2026',
    lede: 'Bubo names the likely cause and one thing to do about it.',
    changes: [
      'Diagnosis banner in plain words',
      'Uptime in the panel header',
      'Memory and battery match what macOS shows',
    ],
  },
  {
    v: '1.2',
    date: '26 Jul 2026',
    lede: 'Clearer at a glance.',
    changes: [
      'CPU tiers named efficiency and performance',
      'Memory split into app, wired, compressed, cached and free',
      'A plain "throttling" badge when the Mac runs hot',
    ],
  },
  {
    v: '1.1',
    date: '25 Jul 2026',
    lede: 'A native build for Intel Macs.',
    changes: [],
  },
  {
    v: '1.0',
    date: '24 Jul 2026',
    lede: 'First release.',
    changes: [
      'Top apps, grouped per app, with one-click quit',
      'CPU, memory, GPU, fan, battery, network and disk',
      'Power rails and temperatures on Apple Silicon',
    ],
  },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Bubo releases</title>
  <meta name="description" content="Every Bubo release, logged. What changed in each build, newest first, and where to download it for Apple Silicon or Intel." />
  <link rel="canonical" href="https://bubo.weekndlabs.com/releases" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://bubo.weekndlabs.com/releases" />
  <meta property="og:site_name" content="Bubo" />
  <meta property="og:title" content="Bubo releases" />
  <meta property="og:description" content="Every Bubo release, logged. Newest first, with the download for your chip." />
  <meta property="og:image" content="https://bubo.weekndlabs.com/og.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://bubo.weekndlabs.com/og.png" />
  <meta name="theme-color" content="#12141F" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#FAF8F3" media="(prefers-color-scheme: light)" />
  <script is:inline>
    const t = localStorage.getItem('bubo-theme');
    if (t) document.documentElement.style.colorScheme = t;
  </script>
</head>
<body>
  <header class="menubar">
    <a class="mb-brand" href="/" aria-label="Bubo, live readout">
      <span class="mb-dot" aria-hidden="true"></span>
      <span class="mb-read"><b>CPU</b> 22%&nbsp;&nbsp;<b>RAM</b> 78%</span>
    </a>
    <nav class="mb-nav">
      <a class="mb-sec" href="/#features">Features</a>
      <a class="mb-sec" href="/#install">Install</a>
      <a href="/releases" aria-current="page">Releases</a>
      <a class="mb-in" href={app}>Account</a>
      <button class="mb-theme" type="button" aria-label="Toggle light or dark theme">☾</button>
    </nav>
  </header>

  <main>
    <section class="rel-hero">
      <h1>Releases</h1>
      <p class="lede">What changed in each version, newest first.</p>
    </section>

    <section class="timeline">
      {releases.map((r) => (
        <article class:list={['release', { 'is-latest': r.latest }]}>
          <span class="rel-dot" aria-hidden="true"></span>
          <div class="rel-body">
            <header class="rel-head">
              <span class="rel-ver">v{r.v}</span>
              <span class="rel-date">{r.date}</span>
              {r.latest && <span class="rel-badge">Latest</span>}
            </header>

            <p class="rel-lede">{r.lede}</p>

            {r.changes.length > 0 && (
              <ul class="rel-log">
                {r.changes.map((c) => <li>{c}</li>)}
              </ul>
            )}

            {r.download && (
              <div class="rel-dl">
                <a class="btn-dl" href={app}>Sign in to download</a>
              </div>
            )}
          </div>
        </article>
      ))}
    </section>
  </main>

  <footer class="footer">
    <div class="foot-brand">
      <img src="/logo.png" alt="" width="40" height="40" />
      <div>
        <div class="foot-name">Bubo</div>
        <p class="foot-tag">The genus of the eagle-owl. It watches all night and misses nothing.</p>
      </div>
    </div>
    <nav class="foot-links">
      <a href="/">Home</a>
      <a href="/#install">Download</a>
      <a href="/terms">Terms</a>
      <a href="/refund">Refunds</a>
      <a href="/privacy">Privacy</a>
      <a href={app}>Account</a>
    </nav>
    <p class="foot-legal">© 2026 fajarhide · Apple Silicon and Intel</p>
  </footer>

  <script>
    // Theme toggle: flip color-scheme on <html> and remember it (shared with home).
    (() => {
      const root = document.documentElement;
      const btn = document.querySelector('.mb-theme');
      const media = matchMedia('(prefers-color-scheme: dark)');
      const current = () => localStorage.getItem('bubo-theme') || (media.matches ? 'dark' : 'light');
      const paint = () => { btn.textContent = current() === 'dark' ? '☾' : '☀'; };
      paint();
      media.addEventListener('change', paint);
      btn?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        localStorage.setItem('bubo-theme', next);
        root.style.colorScheme = next;
        paint();
      });
    })();
  </script>

  <style is:global>
    /* the changelog is a reading column, narrower than the marketing pages */
    :root { --wrap: 760px; }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0; background: var(--night); color: var(--text);
      font-family: var(--body); font-size: 17px; line-height: 1.6;
      -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
      overflow-x: hidden;
    }
    a { color: inherit; }
    h1 { font-family: var(--display); font-weight: 800; letter-spacing: -0.02em; margin: 0; }
    em { font-style: normal; color: var(--amber); }

    /* ---- menu bar (shared chrome) ---- */
    .menubar {
      position: sticky; top: 0; z-index: 50;
      display: flex; align-items: center; justify-content: space-between;
      height: 34px; padding: 0 clamp(14px, 4vw, 40px);
      background: light-dark(rgba(250, 248, 243, 0.72), rgba(18, 20, 31, 0.72));
      backdrop-filter: saturate(140%) blur(14px);
      -webkit-backdrop-filter: saturate(140%) blur(14px);
      border-bottom: 1px solid var(--line-soft);
    }
    .mb-brand { display: flex; align-items: center; gap: 8px; text-decoration: none; }
    .mb-dot {
      width: 9px; height: 9px; border-radius: 50%; background: var(--amber);
      box-shadow: 0 0 0 0 rgba(245, 184, 65, 0.5); animation: pulse 3.4s ease-out infinite;
    }
    .mb-read { font-family: var(--mono); font-size: 0.74rem; color: var(--muted); }
    .mb-read b { color: var(--faint); font-weight: 500; }
    .mb-nav { display: flex; align-items: center; gap: clamp(14px, 3vw, 28px); }
    .mb-nav a {
      font-family: var(--mono); font-size: 0.76rem; text-decoration: none;
      color: var(--muted); transition: color 0.18s;
    }
    .mb-nav a:hover, .mb-nav a[aria-current="page"] { color: var(--amber); }
    .mb-in {
      color: var(--text); border: 1px solid var(--line);
      border-radius: 7px; padding: 3px 10px; line-height: 1.5;
    }
    .mb-in:hover, .mb-nav a.mb-in:hover { border-color: var(--amber); color: var(--amber); }
    .mb-theme {
      font-family: var(--mono); font-size: 0.9rem; line-height: 1;
      background: none; border: 0; padding: 0; cursor: pointer;
      color: var(--muted); transition: color 0.18s;
    }
    .mb-theme:hover { color: var(--amber); }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(245, 184, 65, 0.45); }
      70% { box-shadow: 0 0 0 7px rgba(245, 184, 65, 0); }
      100% { box-shadow: 0 0 0 0 rgba(245, 184, 65, 0); }
    }

    /* ---- release hero ---- */
    .rel-hero {
      max-width: var(--wrap); margin: 0 auto;
      padding: clamp(40px, 8vw, 88px) clamp(20px, 5vw, 40px) clamp(28px, 4vw, 44px);
      animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .rel-hero h1 { font-size: clamp(2.4rem, 6vw, 3.6rem); line-height: 1; }
    .rel-hero .lede { color: var(--muted); font-size: 1.08rem; max-width: 48ch; margin: 1.2rem 0 0; }

    /* ---- the watch log: a status dot on a vertical spine per release ---- */
    .timeline {
      position: relative; max-width: var(--wrap); margin: 0 auto;
      padding: clamp(8px, 2vw, 20px) clamp(20px, 5vw, 40px) clamp(56px, 9vw, 100px);
    }
    /* the spine: a hairline running through the dots */
    .timeline::before {
      content: ''; position: absolute;
      left: calc(clamp(20px, 5vw, 40px) + 6px); top: 14px; bottom: clamp(56px, 9vw, 100px);
      width: 1px; background: var(--line-soft);
    }
    .release { position: relative; padding-left: 34px; padding-bottom: clamp(34px, 5vw, 56px); }
    .release:last-child { padding-bottom: 0; }
    .rel-dot {
      position: absolute; left: 0; top: 7px; width: 13px; height: 13px; border-radius: 50%;
      background: var(--faint); box-shadow: 0 0 0 4px var(--night);
    }
    .is-latest .rel-dot { background: var(--amber); }

    .rel-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .rel-ver { font-family: var(--display); font-weight: 700; font-size: 1.5rem; letter-spacing: -0.01em; }
    .rel-date { font-family: var(--mono); font-size: 0.76rem; color: var(--faint); }
    .rel-badge {
      font-family: var(--mono); font-size: 0.58rem; font-weight: 600; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--amber); background: rgba(245, 184, 65, 0.13);
      padding: 3px 8px; border-radius: 20px;
    }
    .rel-lede { color: var(--muted); font-size: 1.02rem; margin: 12px 0 0; max-width: 56ch; }

    .rel-log { margin: 12px 0 0; padding: 0 0 0 1.1em; font-size: 0.96rem; color: var(--text); }
    .rel-log li { padding: 3px 0; }
    .rel-log li::marker { color: var(--faint); }

    .rel-dl { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; max-width: 440px; }
    .btn-dl {
      flex: 1 1 150px; text-align: center;
      font-family: var(--mono); font-size: 0.86rem; text-decoration: none;
      color: var(--night); background: var(--amber); border: 1px solid transparent;
      border-radius: 10px; padding: 11px 18px;
      transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.1s;
    }
    .btn-dl:hover { background: var(--amber-bright); }
    .btn-dl:active { transform: translateY(1px); }

    /* ---- footer (shared chrome) ---- */
    .footer {
      max-width: var(--wrap); margin: 0 auto;
      padding: clamp(36px, 6vw, 56px) clamp(20px, 5vw, 40px);
      border-top: 1px solid var(--line-soft);
      display: flex; align-items: flex-start; justify-content: space-between;
      gap: 28px; flex-wrap: wrap;
    }
    .foot-brand { display: flex; gap: 14px; align-items: center; max-width: 380px; }
    .foot-brand img { border-radius: 10px; }
    .foot-name { font-family: var(--display); font-weight: 700; font-size: 1.1rem; }
    .foot-tag { color: var(--faint); font-size: 0.86rem; margin: 3px 0 0; line-height: 1.45; }
    .foot-links { display: flex; gap: 22px; flex-wrap: wrap; }
    .foot-links a { font-family: var(--mono); font-size: 0.82rem; text-decoration: none; color: var(--muted); transition: color 0.18s; }
    .foot-links a:hover { color: var(--amber); }
    .foot-legal { width: 100%; font-family: var(--mono); font-size: 0.72rem; color: var(--faint); margin: 8px 0 0; }

    @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

    @media (max-width: 520px) {
      body { font-size: 16px; }
      .mb-read { display: none; }
      .mb-sec { display: none; }
      .rel-dl { flex-direction: column; align-items: stretch; max-width: none; }
      .rel-dl .btn-dl { flex: none; }
    }

    :focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; border-radius: 4px; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto; }
    }
  </style>
</body>
</html>
