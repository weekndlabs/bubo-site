---
const brew = 'brew install fajarhide/tap/bubo';
const repo = 'https://github.com/fajarhide/bubo';
const releases = `${repo}/releases/latest`;
const tap = 'https://github.com/fajarhide/homebrew-tap';

// Direct .dmg links: /latest/download/ serves the file straight away and always
// tracks the newest release, so these never need bumping per version.
const dmgArm = `${repo}/releases/latest/download/Bubo-apple-silicon.dmg`;
const dmgIntel = `${repo}/releases/latest/download/Bubo-intel.dmg`;

// The real sections of the app, used verbatim as the feature list.
const features = [
  { k: 'Top apps',      d: 'The eight heaviest processes, grouped per app, each with its own quit button. This is the whole point.' },
  { k: 'CPU',           d: 'Overall load, per-core bars, efficiency and performance clusters, average temperature and die hotspot.' },
  { k: 'Memory',        d: 'Used against total, DRAM read and write bandwidth, and a swap warning the moment your Mac starts thrashing.' },
  { k: 'GPU & fan',     d: 'GPU usage, frequency and power draw. Live fan RPM, hidden on fanless Macs.' },
  { k: 'Battery',       d: 'Charge, drain or charge rate, adapter watts, cycles, health and cell temperature.' },
  { k: 'Network & disk',d: 'Live throughput sparklines for both, auto-scaled from bytes to gigabytes per second.' },
  { k: 'Power rails',   d: 'Per-rail draw for CPU, GPU, Neural Engine and DRAM, whatever your chip exposes.' },
  { k: 'Optimize',      d: 'Purge the disk cache, or quit every heavy app at once, with a confirmation first.' },
];

const specs = [
  { v: 'Apple Silicon', l: 'native, M1 through M5' },
  { v: 'Tiny',          l: 'a lean native binary' },
  { v: 'No daemon',     l: 'nothing runs in the background' },
  { v: 'No sudo',       l: 'no root, no kernel extension' },
  { v: 'One click',     l: 'to quit the heavy app' },
  { v: 'MIT',           l: 'free and open source' },
];

// The eight cores in the hero panel: efficiency cluster busy, performance idle-ish.
const cores = [78, 64, 55, 40, 88, 72, 30, 22];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Bubo — catch the app slowing your Mac</title>
  <meta name="description" content="A tiny macOS menu-bar monitor that names the app eating your CPU and memory, then quits it in one click. Native Apple Silicon, no daemon, no sudo." />
  <link rel="icon" type="image/png" href="/logo.png" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://bubo.weekndlabs.com/" />
  <meta property="og:site_name" content="Bubo" />
  <meta property="og:title" content="Bubo — catch the app slowing your Mac" />
  <meta property="og:description" content="A tiny macOS menu-bar monitor that names the heavy app and quits it in one click." />
  <meta property="og:image" content="https://bubo.weekndlabs.com/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The Bubo panel catching Google Chrome at 128% CPU, the heaviest app." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Bubo — catch the app slowing your Mac" />
  <meta name="twitter:description" content="A tiny macOS menu-bar monitor that names the heavy app and quits it in one click." />
  <meta name="twitter:image" content="https://bubo.weekndlabs.com/og.png" />
  <meta name="theme-color" content="#12141F" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#FAF8F3" media="(prefers-color-scheme: light)" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <!-- Apply the saved theme before paint so there's no flash of the wrong one. -->
  <script is:inline>
    const t = localStorage.getItem('bubo-theme');
    if (t) document.documentElement.style.colorScheme = t;
  </script>
</head>
<body>
  <!-- The site's chrome is a macOS menu bar, because that is where Bubo lives. -->
  <header class="menubar">
    <a class="mb-brand" href="#top" aria-label="Bubo, live readout">
      <span class="mb-dot" aria-hidden="true"></span>
      <span class="mb-read"><b>CPU</b> 22%&nbsp;&nbsp;<b>RAM</b> 78%</span>
    </a>
    <nav class="mb-nav">
      <a href="#features">Features</a>
      <a href="#install">Install</a>
      <a href={repo} rel="noopener">GitHub ↗</a>
      <button class="mb-theme" type="button" aria-label="Toggle light or dark theme">☾</button>
    </nav>
  </header>

  <main id="top">
    <!-- Hero -->
    <section class="hero">
      <div class="eyes" aria-hidden="true"><span></span><span></span></div>

      <div class="hero-copy">
        <p class="eyebrow">macOS menu-bar monitor</p>
        <h1>Catch the app<br />slowing your Mac.</h1>
        <p class="lede">
          Bubo sits in your menu bar and names the process eating your CPU and
          memory, then quits it in one click. Native Apple Silicon, no daemon,
          no sudo.
        </p>

        <div class="cmd" data-copy={brew}>
          <code><span class="cmd-prompt">$</span> {brew}</code>
          <button class="cmd-btn" type="button" aria-label="Copy install command">Copy</button>
        </div>

        <div class="hero-actions">
          <a class="btn-ghost" href={dmgArm} download rel="noopener">Apple&nbsp;Silicon <span class="dl-ext">.dmg</span></a>
          <a class="btn-ghost" href={dmgIntel} download rel="noopener">Intel&nbsp;Chip <span class="dl-ext">.dmg</span></a>
        </div>
        <p class="dl-hint">Apple Silicon for M1 through M5. Intel for older Macs.</p>
      </div>

      <!-- Signature: a working recreation of the Bubo panel, culprit in red. -->
      <div class="panel-wrap">
        <div class="panel" role="img" aria-label="The Bubo panel, showing Google Chrome as the heaviest app at 128 percent CPU">
          <div class="p-head">
            <div class="p-title">Bubo <span class="p-ver">1.0</span></div>
            <div class="p-badge">BUSY&nbsp;·&nbsp;RAM 78%</div>
          </div>
          <div class="p-sub">M1 · 8 cores</div>

          <div class="p-row-label"><span>CPU</span><b class="sage">22%</b></div>
          <div class="bar"><i style="width:22%" class="fill-sage"></i></div>
          <div class="cores">
            {cores.map((c) => (
              <span class="core"><i style={`height:${Math.max(12, c)}%`} class={c >= 80 ? 'fill-amber' : 'fill-sage'}></i></span>
            ))}
          </div>

          <div class="p-row-label mt"><span>MEMORY</span><b class="amber">6.0 / 8 GB</b></div>
          <div class="bar"><i style="width:78%" class="fill-amber"></i></div>

          <div class="p-apps-head"><span>TOP APPS</span><span class="p-cols">PROC&nbsp;&nbsp;CPU&nbsp;&nbsp;&nbsp;MEM</span></div>
          <div class="app culprit">
            <span class="app-name">Google Chrome</span>
            <span class="app-proc">44</span>
            <span class="app-cpu clay">128%</span>
            <span class="app-mem">1.6 GB</span>
            <span class="app-x" title="Quit Google Chrome">⊗</span>
          </div>
          <div class="app"><span class="app-name">WindowServer</span><span class="app-proc">1</span><span class="app-cpu sage">26%</span><span class="app-mem">36 MB</span><span class="app-x-off"></span></div>
          <div class="app"><span class="app-name">claude</span><span class="app-proc">5</span><span class="app-cpu sage">18%</span><span class="app-mem">840 MB</span><span class="app-x-off"></span></div>
          <div class="app"><span class="app-name">Orca</span><span class="app-proc">6</span><span class="app-cpu sage">14%</span><span class="app-mem">445 MB</span><span class="app-x" title="Quit Orca">⊗</span></div>
        </div>
      </div>
    </section>

    <!-- Problem → answer -->
    <section class="band">
      <p class="band-eyebrow">the difference</p>
      <h2>Activity Monitor makes you go looking.<br /><em>Bubo just tells you.</em></h2>
      <p class="band-body">
        A slow Mac is usually one greedy app. Activity Monitor keeps that answer
        behind a window and a dozen columns. Bubo keeps it in the corner of your
        screen. The dot turns amber, then red, when something starts to drag, and
        one click shows you the culprit and quits it.
      </p>
    </section>

    <!-- Features: the real sections of the app -->
    <section class="features" id="features">
      <div class="sec-head">
        <p class="eyebrow">what one click opens</p>
        <h2>Everything Activity Monitor buries,<br />in one quiet popover.</h2>
      </div>
      <div class="grid">
        {features.map((f) => (
          <article class="card">
            <h3>{f.k}</h3>
            <p>{f.d}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Spec sheet -->
    <section class="specs">
      <div class="spec-row">
        {specs.map((s) => (
          <div class="spec">
            <div class="spec-v">{s.v}</div>
            <div class="spec-l">{s.l}</div>
          </div>
        ))}
      </div>
      <p class="specs-note">
        Power, temperatures, fan speed and DRAM bandwidth come from private
        Apple frameworks that need no root. Everything else is plain macOS APIs.
        Two Swift files, no Electron.
      </p>
    </section>

    <!-- Install -->
    <section class="install" id="install">
      <div class="sec-head">
        <p class="eyebrow">get bubo</p>
        <h2>Put it in your menu bar.</h2>
      </div>

      <div class="dl-row">
        <a class="btn-dl" href={dmgArm} download rel="noopener">
          Apple&nbsp;Silicon <span class="dl-ext">.dmg · M1–M5</span>
        </a>
        <a class="btn-dl btn-dl-alt" href={dmgIntel} download rel="noopener">
          Intel&nbsp;Chip <span class="dl-ext">.dmg</span>
        </a>
      </div>

      <p class="install-note">
        The Homebrew cask clears the Gatekeeper quarantine flag, so Bubo
        launches straight away. From the .dmg, drag Bubo to Applications and open it.
      </p>
    </section>
  </main>

  <footer class="footer">
    <div class="foot-brand">
      <img src="/logo.png" alt="" width="40" height="40" />
      <div>
        <div class="foot-name">Bubo</div>
        <p class="foot-tag">The genus of the eagle-owl. It watches all night and misses nothing.</p>
      </div>
    </div>
    <nav class="foot-links">
      <a href={repo} rel="noopener">GitHub</a>
      <a href={releases} rel="noopener">Releases</a>
      <a href={tap} rel="noopener">Homebrew tap</a>
    </nav>
    <p class="foot-legal">MIT © 2026 fajarhide · Built for Apple Silicon</p>
  </footer>

  <script>
    // Theme toggle: flip color-scheme on <html> and remember it. Until clicked,
    // nothing is stored and the page follows the OS via `color-scheme: light dark`.
    (() => {
      const root = document.documentElement;
      const btn = document.querySelector('.mb-theme');
      const media = matchMedia('(prefers-color-scheme: dark)');
      const current = () => localStorage.getItem('bubo-theme') || (media.matches ? 'dark' : 'light');
      const paint = () => { btn.textContent = current() === 'dark' ? '☾' : '☀'; };
      paint();
      media.addEventListener('change', paint);
      btn?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        localStorage.setItem('bubo-theme', next);
        root.style.colorScheme = next;
        paint();
      });
    })();

    // Copy the install command; the button reports success in its own label.
    document.querySelectorAll('.cmd').forEach((box) => {
      const btn = box.querySelector('.cmd-btn');
      const text = box.getAttribute('data-copy') || '';
      btn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(text);
          const prev = btn.textContent;
          btn.textContent = 'Copied';
          btn.classList.add('is-copied');
          setTimeout(() => { btn.textContent = prev; btn.classList.remove('is-copied'); }, 1600);
        } catch { /* clipboard blocked; leave the command visible to select */ }
      });
    });
  </script>

  <style is:global>
    /* Each token carries both themes via light-dark(); color-scheme picks one.
       Default `light dark` follows the OS, and the toggle overrides it by setting
       color-scheme on <html>. Amber deepens in light so it holds as text on paper. */
    :root {
      color-scheme: light dark;
      --night: light-dark(#FAF8F3, #12141F);
      --night-2: light-dark(#F0ECE2, #1A1D2B);
      --card: light-dark(#F4F0E7, #1E2333);
      --line: light-dark(#D8D1C0, #2A3048);
      --line-soft: light-dark(#E4DECF, #21273a);
      --amber: light-dark(#9C6100, #F5B841);
      --amber-bright: light-dark(#B87400, #FCD670);
      --sage: #6BCC8F;
      --clay: #E0776F;
      --text: light-dark(#1C1E28, #ECEEF5);
      --muted: light-dark(#5A5F70, #8A90A6);
      --faint: light-dark(#787E90, #565D75);
      --display: 'Bricolage Grotesque', system-ui, sans-serif;
      --body: 'Inter', system-ui, sans-serif;
      --mono: 'JetBrains Mono', ui-monospace, monospace;
      --wrap: 1120px;
    }

    /* success button is light-green in both themes, so pin dark ink on it */
    .cmd-btn.is-copied { color: #10261A; }
    /* the panel recreates Bubo's dark macOS popover: keep it dark in both themes */
    .panel { color-scheme: dark; }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--night);
      color: var(--text);
      font-family: var(--body);
      font-size: 17px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      overflow-x: hidden;
    }
    a { color: inherit; }
    h1, h2, h3 { font-family: var(--display); font-weight: 700; letter-spacing: -0.02em; margin: 0; }
    em { font-style: normal; color: var(--amber); }

    .eyebrow, .band-eyebrow {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--amber);
      margin: 0 0 1.1rem;
    }

    /* ---- menu bar nav ---- */
    .menubar {
      position: sticky; top: 0; z-index: 50;
      display: flex; align-items: center; justify-content: space-between;
      height: 34px; padding: 0 clamp(14px, 4vw, 40px);
      background: light-dark(rgba(250, 248, 243, 0.72), rgba(18, 20, 31, 0.72));
      backdrop-filter: saturate(140%) blur(14px);
      -webkit-backdrop-filter: saturate(140%) blur(14px);
      border-bottom: 1px solid var(--line-soft);
    }
    .mb-brand { display: flex; align-items: center; gap: 8px; text-decoration: none; }
    .mb-dot {
      width: 9px; height: 9px; border-radius: 50%;
      background: var(--amber);
      box-shadow: 0 0 0 0 rgba(245, 184, 65, 0.5);
      animation: pulse 3.4s ease-out infinite;
    }
    .mb-read { font-family: var(--mono); font-size: 0.74rem; color: var(--muted); }
    .mb-read b { color: var(--faint); font-weight: 500; }
    .mb-nav { display: flex; gap: clamp(14px, 3vw, 28px); }
    .mb-nav a {
      font-family: var(--mono); font-size: 0.76rem; text-decoration: none;
      color: var(--muted); transition: color 0.18s;
    }
    .mb-nav a:hover { color: var(--amber); }
    .mb-theme {
      font-family: var(--mono); font-size: 0.9rem; line-height: 1;
      background: none; border: 0; padding: 0; cursor: pointer;
      color: var(--muted); transition: color 0.18s;
    }
    .mb-theme:hover { color: var(--amber); }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(245, 184, 65, 0.45); }
      70% { box-shadow: 0 0 0 7px rgba(245, 184, 65, 0); }
      100% { box-shadow: 0 0 0 0 rgba(245, 184, 65, 0); }
    }

    /* ---- hero ---- */
    .hero {
      position: relative;
      max-width: var(--wrap); margin: 0 auto;
      padding: clamp(48px, 9vw, 104px) clamp(20px, 5vw, 40px) clamp(40px, 7vw, 88px);
      display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(32px, 5vw, 72px);
      align-items: center;
    }
    /* the owl's eyes: two amber glows watching from the dark */
    .eyes { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
    .eyes span {
      position: absolute; top: 12%; width: 320px; height: 320px; border-radius: 50%;
      background: radial-gradient(circle, rgba(245, 184, 65, 0.16), transparent 62%);
      filter: blur(6px); animation: gaze 7s ease-in-out infinite;
    }
    .eyes span:first-child { left: 30%; }
    .eyes span:last-child { left: 52%; animation-delay: 0.6s; }
    @keyframes gaze { 0%, 100% { opacity: 0.75; } 50% { opacity: 1; } }

    .hero-copy { position: relative; z-index: 1; animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    h1 { font-size: clamp(2.6rem, 6.4vw, 4.6rem); line-height: 0.98; font-weight: 800; }
    .lede { color: var(--muted); font-size: 1.12rem; max-width: 30ch; margin: 1.4rem 0 2rem; }

    .cmd {
      display: flex; align-items: center; gap: 10px;
      background: var(--night-2); border: 1px solid var(--line);
      border-radius: 12px; padding: 12px 12px 12px 16px; max-width: 440px;
    }
    .cmd code {
      font-family: var(--mono); font-size: 0.92rem; color: var(--text);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      flex: 1; min-width: 0; /* flex item must shrink or nowrap text overflows the viewport */
    }
    .cmd-prompt { color: var(--amber); margin-right: 8px; }
    .cmd-btn {
      font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.04em;
      color: var(--night); background: var(--amber); border: 0;
      border-radius: 7px; padding: 7px 13px; cursor: pointer;
      transition: background 0.18s, transform 0.1s;
    }
    .cmd-btn:hover { background: var(--amber-bright); }
    .cmd-btn:active { transform: translateY(1px); }
    .cmd-btn.is-copied { background: var(--sage); }

    /* match the brew box width above; two equal buttons that stack on narrow screens */
    .hero-actions { display: flex; gap: 10px; margin-top: 12px; max-width: 440px; flex-wrap: wrap; }
    .btn-ghost {
      flex: 1 1 170px; text-align: center;
      font-family: var(--mono); font-size: 0.82rem; text-decoration: none;
      color: var(--text); border: 1px solid var(--line);
      border-radius: 9px; padding: 10px 16px; transition: border-color 0.18s, color 0.18s;
    }
    .btn-ghost:hover { border-color: var(--amber); color: var(--amber); }
    .dl-hint { font-family: var(--mono); font-size: 0.74rem; color: var(--faint); margin: 10px 0 0; }

    /* ---- panel recreation ---- */
    .panel-wrap { position: relative; z-index: 1; animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.12s both; }
    .panel {
      background: linear-gradient(180deg, #1b2030, #14172250);
      background-color: var(--night-2);
      border: 1px solid var(--line);
      border-radius: 18px; padding: 18px;
      box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(245, 184, 65, 0.04);
      max-width: 360px; margin-left: auto;
    }
    .p-head { display: flex; align-items: baseline; justify-content: space-between; }
    .p-title { font-family: var(--display); font-weight: 700; font-size: 1.05rem; }
    .p-ver { font-family: var(--mono); font-size: 0.66rem; color: var(--faint); font-weight: 400; }
    .p-badge {
      font-family: var(--mono); font-size: 0.6rem; font-weight: 600; letter-spacing: 0.04em;
      color: var(--amber); background: rgba(245, 184, 65, 0.13);
      padding: 3px 8px; border-radius: 20px;
    }
    .p-sub { font-family: var(--mono); font-size: 0.68rem; color: var(--faint); margin-top: 2px; }

    .p-row-label { display: flex; align-items: baseline; justify-content: space-between; margin-top: 16px; }
    .p-row-label.mt { margin-top: 18px; }
    .p-row-label span {
      font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--faint);
    }
    .p-row-label b { font-family: var(--mono); font-size: 1.05rem; font-weight: 600; }

    .bar { height: 7px; border-radius: 6px; background: #2b3147; margin-top: 7px; overflow: hidden; }
    .bar i { display: block; height: 100%; border-radius: 6px; }
    .fill-sage { background: var(--sage); }
    .fill-amber { background: var(--amber); }
    .fill-clay { background: var(--clay); }
    .sage { color: var(--sage); }
    .amber { color: var(--amber); }
    .clay { color: var(--clay); }

    .cores { display: flex; gap: 4px; align-items: flex-end; height: 22px; margin-top: 8px; }
    .core { flex: 1; height: 100%; background: #2b3147; border-radius: 4px; display: flex; align-items: flex-end; overflow: hidden; }
    .core i { width: 100%; border-radius: 4px; }

    .p-apps-head {
      display: flex; justify-content: space-between; margin: 18px 0 4px;
      font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--faint);
    }
    .app {
      display: grid; grid-template-columns: 1fr auto auto auto 18px;
      align-items: center; gap: 10px;
      font-family: var(--mono); font-size: 0.78rem; color: var(--text);
      padding: 5px 6px; border-radius: 6px;
    }
    .app-proc, .app-mem { color: var(--muted); }
    .app-cpu { text-align: right; }
    .app-x { color: var(--muted); cursor: default; text-align: center; }
    .app-x-off { width: 18px; }
    .app.culprit { background: rgba(224, 119, 111, 0.14); }
    .app.culprit .app-name { color: var(--text); }

    /* ---- problem band ---- */
    .band {
      max-width: 820px; margin: 0 auto; text-align: center;
      padding: clamp(56px, 10vw, 120px) clamp(20px, 5vw, 40px);
      border-top: 1px solid var(--line-soft);
    }
    .band h2 { font-size: clamp(1.9rem, 4.6vw, 3.1rem); line-height: 1.05; margin-bottom: 1.4rem; }
    .band-body { color: var(--muted); font-size: 1.1rem; max-width: 60ch; margin: 0 auto; }

    /* ---- features ---- */
    .features { max-width: var(--wrap); margin: 0 auto; padding: clamp(40px, 7vw, 80px) clamp(20px, 5vw, 40px); }
    .sec-head { margin-bottom: clamp(28px, 4vw, 52px); }
    .sec-head h2 { font-size: clamp(1.8rem, 4.2vw, 2.8rem); line-height: 1.05; }
    .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .card {
      background: var(--card); border: 1px solid var(--line-soft);
      border-radius: 14px; padding: 22px 20px 24px;
      transition: border-color 0.2s, transform 0.2s;
    }
    .card:hover { border-color: var(--line); transform: translateY(-3px); }
    .card h3 {
      font-family: var(--mono); font-size: 0.82rem; font-weight: 600;
      letter-spacing: 0.02em; color: var(--amber); margin-bottom: 10px;
    }
    .card p { color: var(--muted); font-size: 0.95rem; line-height: 1.55; margin: 0; }

    /* ---- specs ---- */
    .specs {
      max-width: var(--wrap); margin: 0 auto;
      padding: clamp(24px, 4vw, 40px) clamp(20px, 5vw, 40px) clamp(48px, 8vw, 88px);
    }
    .spec-row {
      display: grid; grid-template-columns: repeat(6, 1fr);
      border: 1px solid var(--line-soft); border-radius: 16px; overflow: hidden;
    }
    .spec { padding: 26px 22px; border-right: 1px solid var(--line-soft); }
    .spec:last-child { border-right: 0; }
    .spec-v { font-family: var(--display); font-weight: 700; font-size: 1.35rem; letter-spacing: -0.01em; }
    .spec-l { font-family: var(--mono); font-size: 0.68rem; color: var(--muted); margin-top: 6px; line-height: 1.4; }
    .specs-note { color: var(--faint); font-size: 0.9rem; max-width: 68ch; margin: 22px auto 0; text-align: center; }

    /* ---- install ---- */
    .install {
      max-width: 760px; margin: 0 auto; text-align: center;
      padding: clamp(48px, 8vw, 96px) clamp(20px, 5vw, 40px);
      border-top: 1px solid var(--line-soft);
    }
    .install .sec-head { margin-bottom: 28px; }
    .install .sec-head .eyebrow { text-align: center; }
    .cmd-big { max-width: 520px; margin: 0 auto; padding: 16px 16px 16px 20px; }
    .cmd-big code { font-size: 1rem; }
    .dl-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .btn-dl {
      display: inline-block; font-family: var(--mono); font-size: 0.9rem;
      text-decoration: none; color: var(--night); background: var(--amber);
      border: 1px solid transparent;
      border-radius: 10px; padding: 13px 22px; transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.1s;
    }
    .btn-dl:hover { background: var(--amber-bright); }
    .btn-dl:active { transform: translateY(1px); }
    .dl-ext { font-size: 0.78em; opacity: 0.7; }
    /* Intel is the secondary arch: ghost button so Apple Silicon reads as primary. */
    .btn-dl-alt { background: none; color: var(--text); border-color: var(--line); }
    .btn-dl-alt:hover { background: none; border-color: var(--amber); color: var(--amber); }
    .install-note { color: var(--muted); font-size: 0.98rem; margin: 24px auto 0; max-width: 54ch; }
    .install-note a { color: var(--amber); text-decoration: none; border-bottom: 1px solid rgba(245,184,65,0.3); }
    .install-note b { color: var(--text); font-weight: 600; }

    /* ---- footer ---- */
    .footer {
      max-width: var(--wrap); margin: 0 auto;
      padding: clamp(36px, 6vw, 56px) clamp(20px, 5vw, 40px);
      border-top: 1px solid var(--line-soft);
      display: flex; align-items: flex-start; justify-content: space-between;
      gap: 28px; flex-wrap: wrap;
    }
    .foot-brand { display: flex; gap: 14px; align-items: center; max-width: 380px; }
    .foot-brand img { border-radius: 10px; }
    .foot-name { font-family: var(--display); font-weight: 700; font-size: 1.1rem; }
    .foot-tag { color: var(--faint); font-size: 0.86rem; margin: 3px 0 0; line-height: 1.45; }
    .foot-links { display: flex; gap: 22px; }
    .foot-links a { font-family: var(--mono); font-size: 0.82rem; text-decoration: none; color: var(--muted); transition: color 0.18s; }
    .foot-links a:hover { color: var(--amber); }
    .foot-legal { width: 100%; font-family: var(--mono); font-size: 0.72rem; color: var(--faint); margin: 8px 0 0; }

    @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

    /* ---- responsive ---- */
    @media (max-width: 860px) {
      .hero { grid-template-columns: 1fr; }
      .panel-wrap { order: -1; }
      .panel { margin: 0 auto; }
      .grid { grid-template-columns: repeat(2, 1fr); }
      .spec-row { grid-template-columns: repeat(3, 1fr); }
      .spec:nth-child(3) { border-right: 0; }
      .spec:nth-child(-n+3) { border-bottom: 1px solid var(--line-soft); }
    }
    @media (max-width: 520px) {
      body { font-size: 16px; }
      .mb-read { display: none; }
      /* On phones show the full command over two lines instead of ellipsis-hiding it. */
      .cmd { flex-wrap: wrap; }
      .cmd code { white-space: normal; overflow: visible; text-overflow: clip; word-break: break-word; flex-basis: 100%; }
      .cmd-btn { flex: 1; }
      .grid { grid-template-columns: 1fr; }
      .spec-row { grid-template-columns: repeat(2, 1fr); }
      .spec { border-right: 1px solid var(--line-soft); }
      .spec:nth-child(2n) { border-right: 0; }
      .spec:nth-child(-n+4) { border-bottom: 1px solid var(--line-soft); }
      .footer { flex-direction: column; }
    }

    :focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; border-radius: 4px; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto; }
    }
  </style>
</body>
</html>
