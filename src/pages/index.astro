---
import Analytics from '@vercel/analytics/astro';
import '../styles/tokens.css';

// Bubo ships from this site. The .dmg files live in public/ and are committed
// per release, so a new version means replacing both files and this number.
const version = '1.4';

// Bubo ID, the signed-in half: it holds a Pro key and the Macs it runs on.
// Downloading needs no account, so this is a quiet nav link and not a CTA.
//
// The label is neutral because this page cannot tell a signed-in visitor from a
// stranger: it is prerendered and served from a CDN, and the Clerk session cookie
// belongs to app.bubo.weekndlabs.com, which the apex domain is not allowed to
// read. "Sign in" was wrong for anyone already signed in.
//
// "Account" rather than "Bubo ID": the destination still calls itself Bubo ID,
// the way an Apple ID is reached from a link that says Account, but a stranger
// has to learn the brand's vocabulary before Bubo ID means anything to them.
const app = 'https://app.bubo.weekndlabs.com';
const dmgArm = '/Bubo-apple-silicon.dmg';
const dmgIntel = '/Bubo-intel.dmg';

// The real sections of the app, used verbatim as the feature list.
// arch: 'all' runs on Intel too; 'as' needs the private Apple Silicon sensors.
const features = [
  { k: 'Diagnosis',     arch: 'all', d: 'One line at the top of the panel: what is wrong, which app is doing it, and one thing to do about it. Memory pressure, a runaway in the background, throttling from heat, a startup disk close to full. Bubo only advises, so the quit is still your click. When nothing is wrong it says all healthy.' },
  { k: 'Top apps',      arch: 'all', d: 'The eight heaviest processes, grouped per app, each with its own quit button. This is the whole point.' },
  { k: 'CPU',           arch: 'all', d: 'Overall load, then a row per core tier with a bar for every core in it, that tier\'s usage and its speed. Temperature, hotspot, pressure and fan sit under the bar, the fan against its own floor and ceiling so the RPM means something. The badge says throttling in plain words when it gets hot.' },
  { k: 'Memory',        arch: 'all', d: 'Used against total, broken into app, wired, compressed, cached and free, so you see what your RAM is actually spent on. The figures agree with Activity Monitor, per app and for the system. DRAM bandwidth too, and pressure read from the OS rather than guessed at.' },
  { k: 'GPU',           arch: 'as',  d: 'Usage, frequency and power draw, read from the same private sensors as the temperatures.' },
  { k: 'Battery',       arch: 'all', d: 'The same charge macOS itself reports, plus drain or charge rate, adapter watts, cycles, health and cell temperature.' },
  { k: 'Network & disk',arch: 'all', d: 'Live throughput sparklines for both, auto-scaled from bytes to gigabytes per second.' },
  { k: 'Power rails',   arch: 'as',  d: 'Per-rail draw for CPU, GPU, Neural Engine and DRAM, whatever your chip exposes.' },
  { k: 'Optimize',      arch: 'all', d: 'Purge the disk cache, or quit every heavy app at once, with a confirmation first.' },
];

const specs = [
  { v: 'Universal',     l: 'Apple Silicon and Intel' },
  { v: 'Tiny',          l: 'a lean native binary' },
  { v: 'No daemon',     l: 'nothing runs in the background' },
  { v: 'No sudo',       l: 'no root, no kernel extension' },
  { v: 'One click',     l: 'to quit the heavy app' },
  { v: 'macOS 13+',     l: 'Ventura and later' },
];

const faqs = [
  { q: 'How is this different from Activity Monitor?',
    a: 'Activity Monitor shows you numbers and leaves you to read them. Bubo does that part for you. It says memory is tight and Chrome is holding 4 GB of it, then quits Chrome in one click. Same data, one line instead of a dozen columns.' },
  { q: 'Will a monitor slow my Mac down too?',
    a: 'Bubo is a lean native binary with no background daemon. It samples on a light interval and stays out of the way otherwise.' },
  { q: 'Is it safe? It reads private Apple sensors.',
    a: 'Power, temperature and fan readings come from Apple\'s own private frameworks that need no root, no kernel extension and no sudo. Everything else is plain macOS APIs. Bubo never asks for your password, and nothing of it keeps running once you quit it.' },
  { q: 'Which download do I pick?',
    a: 'Apple Silicon (M1–M5) for the full panel. Intel for the essentials: CPU, memory, top apps, battery, network and disk. Both follow your system light and dark.' },
];

// Hero panel core tiers. Named in full instead of E / P, one row each; since
// v1.4 each row draws a bar per core and ends in that tier's usage and average
// frequency. The tier percentages are the cluster's active residency, which sits
// above the system-wide CPU figure rather than averaging out to it.
const tiers = [
  { k: 'efficiency',  cores: [78, 64, 55, 40], use: '59%', freq: '1.8 GHz' },
  { k: 'performance', cores: [34, 26, 20, 15], use: '24%', freq: '2.5 GHz' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Bubo — catch the app slowing your Mac</title>
  <meta name="description" content="A tiny macOS menu-bar monitor that tells you why your Mac is slow in one line, names the app doing it, and quits it in one click. Native on Apple Silicon and Intel, no daemon, no sudo." />
  <link rel="canonical" href="https://bubo.weekndlabs.com/" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://bubo.weekndlabs.com/" />
  <meta property="og:site_name" content="Bubo" />
  <meta property="og:title" content="Bubo — catch the app slowing your Mac" />
  <meta property="og:description" content="A tiny macOS menu-bar monitor that names the cause in one line, then quits the heavy app in one click. Native on Apple Silicon and Intel." />
  <meta property="og:image" content="https://bubo.weekndlabs.com/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The Bubo panel naming Google Chrome as the reason memory is tight, and the app caught at 128% CPU." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Bubo — catch the app slowing your Mac" />
  <meta name="twitter:description" content="A tiny macOS menu-bar monitor that names the cause in one line, then quits the heavy app in one click. Native on Apple Silicon and Intel." />
  <meta name="twitter:image" content="https://bubo.weekndlabs.com/og.png" />
  <meta name="theme-color" content="#12141F" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#FAF8F3" media="(prefers-color-scheme: light)" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <!-- Apply the saved theme before paint so there's no flash of the wrong one. -->
  <script is:inline>
    const t = localStorage.getItem('bubo-theme');
    if (t) document.documentElement.style.colorScheme = t;
  </script>
</head>
<body>
  <!-- The site's chrome is a macOS menu bar, because that is where Bubo lives. -->
  <header class="menubar">
    <a class="mb-brand" href="#top" aria-label="Bubo, live readout">
      <span class="mb-dot" aria-hidden="true"></span>
      <span class="mb-read"><b>CPU</b> 22%&nbsp;&nbsp;<b>RAM</b> 78%</span>
    </a>
    <nav class="mb-nav">
      <a class="mb-sec" href="#features">Features</a>
      <a class="mb-sec" href="#install">Install</a>
      <a href="/releases">Releases</a>
      <a class="mb-in" href={app}>Account</a>
      <button class="mb-theme" type="button" aria-label="Toggle light or dark theme">☾</button>
    </nav>
  </header>

  <main id="top">
    <!-- Hero -->
    <section class="hero">
      <div class="eyes" aria-hidden="true"><span></span><span></span></div>

      <div class="hero-copy">
        <p class="eyebrow">macOS menu-bar monitor</p>
        <h1>Catch the app<br />slowing your Mac.</h1>
        <p class="lede">
          Bubo sits in your menu bar and tells you what is wrong in one line,
          names the app doing it, and quits it in one click. Native on Apple
          Silicon and Intel, no daemon, no sudo.
        </p>

        <div class="hero-actions">
          <a class="btn-dl" href={dmgArm} download>Apple&nbsp;Silicon <span class="dl-ext">.dmg</span></a>
          <a class="btn-dl btn-dl-alt" href={dmgIntel} download>Intel&nbsp;Chip <span class="dl-ext">.dmg</span></a>
        </div>
        <p class="dl-hint">Version {version}. Apple Silicon for M1 through M5. Intel for older Macs.</p>
      </div>

      <!-- Signature: a working recreation of the Bubo panel, culprit in red. -->
      <div class="panel-wrap">
        <div class="panel" role="img" aria-label="The Bubo panel, naming Google Chrome as the reason memory is tight and suggesting you quit it">
          <div class="p-head">
            <div class="p-title">Bubo <span class="p-ver">1.4</span></div>
            <div class="p-badge">BUSY&nbsp;·&nbsp;RAM 78%</div>
          </div>
          <div class="p-sub">M1 · 8 cores · up 4h 12m</div>

          <!-- v1.3: the diagnosis line. Italic and header-sized, because it is
               Bubo annotating the panel rather than another reading inside it. -->
          <p class="p-dx"><span class="p-dx-mark clay">⚠</span> Memory is tight. Google Chrome is using 1.6 GB. Quit it if you don't need it.</p>

          <div class="p-row-label"><span>CPU</span><b class="sage">22%</b></div>
          <div class="bar"><i style="width:22%" class="fill-sage"></i></div>
          <div class="p-facts">
            <span><i>temp</i><b>44 °C</b></span>
            <span><i>hotspot</i><b>52 °C</b></span>
            <span><i>pressure</i><b>nominal</b></span>
          </div>
          <!-- v1.4: the fan reads against its own floor and ceiling, which is what
               makes the RPM mean anything, so it sits under the temperatures. -->
          <div class="p-facts">
            <span><i>fan</i><b>1191 RPM</b></span>
            <span><i>floor</i><b>1199</b></span>
            <span><i>ceiling</i><b>7199</b></span>
          </div>
          {tiers.map((t) => (
            <div class="tier">
              <span class="tier-k">{t.k}</span>
              <div class="cores">
                {t.cores.map((c) => (
                  <span class="core"><i style={`width:${Math.max(6, c)}%`} class="fill-sage"></i></span>
                ))}
              </div>
              <b class="tier-v sage">{t.use}</b>
              <span class="tier-f">{t.freq}</span>
            </div>
          ))}

          <div class="p-row-label mt"><span>MEMORY</span><b class="amber">6.0 / 8 GB</b></div>
          <!-- v1.4: DRAM bandwidth is a rate, so it reads above the bar instead of
               among the amounts app / wired / compressed / cached are measured in. -->
          <div class="p-facts">
            <span><i>read</i><b>1.4 GB/s</b></span>
            <span><i>write</i><b>846 MB/s</b></span>
          </div>
          <div class="bar bar-seg">
            <i class="seg-app" style="width:51%"></i>
            <i class="seg-wired" style="width:15%"></i>
            <i class="seg-comp" style="width:9%"></i>
            <i class="seg-cache" style="width:17%"></i>
          </div>
          <div class="mem-legend">
            <span><i class="dot-app"></i>app 4.1</span>
            <span><i class="dot-wired"></i>wired 1.2</span>
            <span><i class="dot-comp"></i>compressed 0.7</span>
            <span><i class="dot-cache"></i>cached 1.4</span>
          </div>

          <div class="p-apps-head"><span>TOP APPS</span><span class="p-cols">PROC&nbsp;&nbsp;CPU&nbsp;&nbsp;&nbsp;MEM</span></div>
          <div class="app culprit">
            <span class="app-name">Google Chrome</span>
            <span class="app-proc">44</span>
            <span class="app-cpu clay">128%</span>
            <span class="app-mem">1.6 GB</span>
            <span class="app-x" title="Quit Google Chrome">⊗</span>
          </div>
          <div class="app"><span class="app-name">WindowServer</span><span class="app-proc">1</span><span class="app-cpu sage">26%</span><span class="app-mem">36 MB</span><span class="app-x-off"></span></div>
          <div class="app"><span class="app-name">claude</span><span class="app-proc">5</span><span class="app-cpu sage">18%</span><span class="app-mem">840 MB</span><span class="app-x-off"></span></div>
          <div class="app"><span class="app-name">Orca</span><span class="app-proc">6</span><span class="app-cpu sage">14%</span><span class="app-mem">445 MB</span><span class="app-x" title="Quit Orca">⊗</span></div>
        </div>
      </div>
    </section>

    <!-- Problem → answer, shown in the real app -->
    <section class="band">
      <p class="band-eyebrow">the difference</p>
      <h2>Activity Monitor makes you go looking.<br /><em>Bubo just tells you.</em></h2>
      <p class="band-body">
        A slow Mac is usually one greedy app. Activity Monitor keeps that answer
        behind a window and a dozen columns you have to read yourself. Bubo keeps
        it in the corner of your screen and does the reading. The dot turns amber,
        then red, and one click opens a line naming the app and what to do.
        Quitting it is still your call; Bubo never acts on its own.
      </p>
      <figure class="demo-frame">
        <video
          class="demo-video"
          autoplay muted loop playsinline preload="metadata"
          poster="/demo-poster.jpg" width="1920" height="1080"
          aria-label="Bubo in the macOS menu bar catching the heaviest app and quitting it in one click"
        >
          <source src="/demo.mp4" type="video/mp4" />
        </video>
        <figcaption>One glance, then one click.</figcaption>
      </figure>
    </section>

    <!-- Features: the real sections of the app -->
    <section class="features" id="features">
      <div class="sec-head">
        <p class="eyebrow">what one click opens</p>
        <h2>Everything Activity Monitor buries,<br />in one quiet panel.</h2>
      </div>
      <div class="grid">
        {features.map((f) => (
          <article class="card">
            <span class={`card-arch card-arch--${f.arch}`}>{f.arch === 'as' ? 'M-series' : 'All Macs'}</span>
            <h3>{f.k}</h3>
            <p>{f.d}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Spec sheet -->
    <section class="specs">
      <div class="spec-row">
        {specs.map((s) => (
          <div class="spec">
            <div class="spec-v">{s.v}</div>
            <div class="spec-l">{s.l}</div>
          </div>
        ))}
      </div>
      <p class="specs-note">
        Power, temperatures, fan speed and DRAM bandwidth come from private
        Apple frameworks that need no root. Everything else is plain macOS APIs.
        Two Swift files, no Electron.
      </p>
    </section>

    <!-- FAQ: the questions before installing -->
    <section class="faq">
      <div class="sec-head faq-head">
        <p class="eyebrow">before you install</p>
        <h2>The usual questions.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <div class="faq-item">
            <h3 class="faq-q">{f.q}</h3>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Focus statement: the emotional close before the CTA -->
    <section class="focus">
      <p>Keep your focus,<br /><em>ignore the distraction.</em></p>
    </section>

    <!-- Install -->
    <section class="install" id="install">
      <div class="sec-head">
        <p class="eyebrow">get bubo</p>
        <h2>Put it in your menu bar.</h2>
      </div>

      <div class="dl-row">
        <a class="btn-dl" href={dmgArm} download>
          Apple&nbsp;Silicon <span class="dl-ext">.dmg · M1–M5</span>
        </a>
        <a class="btn-dl btn-dl-alt" href={dmgIntel} download>
          Intel&nbsp;Chip <span class="dl-ext">.dmg</span>
        </a>
      </div>

      <p class="install-note">
        Version {version}. Open the .dmg and drag Bubo to Applications. macOS
        quarantines anything downloaded from the web, so the first launch is
        <b>right-click, then Open</b>, once. After that it opens normally.
      </p>
    </section>
  </main>

  <footer class="footer">
    <div class="foot-brand">
      <img src="/logo.png" alt="" width="40" height="40" />
      <div>
        <div class="foot-name">Bubo</div>
        <p class="foot-tag">The genus of the eagle-owl. It watches all night and misses nothing.</p>
      </div>
    </div>
    <nav class="foot-links">
      <a href="#install">Download</a>
      <a href="/releases">Releases</a>
      <a href={app}>Account</a>
    </nav>
    <p class="foot-legal">© 2026 fajarhide · Apple Silicon and Intel</p>
  </footer>

  <script>
    // Theme toggle: flip color-scheme on <html> and remember it. Until clicked,
    // nothing is stored and the page follows the OS via `color-scheme: light dark`.
    (() => {
      const root = document.documentElement;
      const btn = document.querySelector('.mb-theme');
      const media = matchMedia('(prefers-color-scheme: dark)');
      const current = () => localStorage.getItem('bubo-theme') || (media.matches ? 'dark' : 'light');
      const paint = () => { btn.textContent = current() === 'dark' ? '☾' : '☀'; };
      paint();
      media.addEventListener('change', paint);
      btn?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        localStorage.setItem('bubo-theme', next);
        root.style.colorScheme = next;
        paint();
      });
    })();

    // Respect reduced motion: don't autoplay the demo, hand over controls instead.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const v = document.querySelector('.demo-video');
      if (v) { v.removeAttribute('autoplay'); v.pause(); v.setAttribute('controls', ''); }
    }
  </script>

  <style is:global>

    /* The hero panel drifts between its dark and light looks. Registered
       color props interpolate, so every child reading these vars fades smoothly. */
    @property --p-bg    { syntax: '<color>'; inherits: true; initial-value: #1A1D2B; }
    @property --p-line  { syntax: '<color>'; inherits: true; initial-value: #2A3048; }
    @property --p-text  { syntax: '<color>'; inherits: true; initial-value: #ECEEF5; }
    @property --p-muted { syntax: '<color>'; inherits: true; initial-value: #8A90A6; }
    @property --p-faint { syntax: '<color>'; inherits: true; initial-value: #565D75; }
    @property --p-track { syntax: '<color>'; inherits: true; initial-value: #2b3147; }
    @property --p-amber { syntax: '<color>'; inherits: true; initial-value: #F5B841; }
    @property --p-sage  { syntax: '<color>'; inherits: true; initial-value: #6BCC8F; }
    @property --p-clay  { syntax: '<color>'; inherits: true; initial-value: #E0776F; }
    @keyframes panelTheme {
      0%, 42%   { --p-bg: #1A1D2B; --p-line: #2A3048; --p-text: #ECEEF5; --p-muted: #8A90A6; --p-faint: #565D75; --p-track: #2b3147; --p-amber: #F5B841; --p-sage: #6BCC8F; --p-clay: #E0776F; }
      58%, 100% { --p-bg: #F4F2EC; --p-line: #DED9CD; --p-text: #1C1E28; --p-muted: #5A5F70; --p-faint: #8A8FA0; --p-track: #E2DED2; --p-amber: #975E00; --p-sage: #2A6B41; --p-clay: #9B3E37; }
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--night);
      color: var(--text);
      font-family: var(--body);
      font-size: 17px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      overflow-x: hidden;
    }
    a { color: inherit; }
    h1, h2, h3 { font-family: var(--display); font-weight: 700; letter-spacing: -0.02em; margin: 0; }
    em { font-style: normal; color: var(--amber); }

    .eyebrow, .band-eyebrow {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--amber);
      margin: 0 0 1.1rem;
    }

    /* ---- menu bar nav ---- */
    .menubar {
      position: sticky; top: 0; z-index: 50;
      display: flex; align-items: center; justify-content: space-between;
      height: 34px; padding: 0 clamp(14px, 4vw, 40px);
      background: light-dark(rgba(250, 248, 243, 0.72), rgba(18, 20, 31, 0.72));
      backdrop-filter: saturate(140%) blur(14px);
      -webkit-backdrop-filter: saturate(140%) blur(14px);
      border-bottom: 1px solid var(--line-soft);
    }
    .mb-brand { display: flex; align-items: center; gap: 8px; text-decoration: none; }
    .mb-dot {
      width: 9px; height: 9px; border-radius: 50%;
      background: var(--amber);
      box-shadow: 0 0 0 0 rgba(245, 184, 65, 0.5);
      animation: pulse 3.4s ease-out infinite;
    }
    .mb-read { font-family: var(--mono); font-size: 0.74rem; color: var(--muted); }
    .mb-read b { color: var(--faint); font-weight: 500; }
    .mb-nav { display: flex; gap: clamp(14px, 3vw, 28px); }
    .mb-nav a {
      font-family: var(--mono); font-size: 0.76rem; text-decoration: none;
      color: var(--muted); transition: color 0.18s;
    }
    .mb-nav a:hover { color: var(--amber); }
    /* the one nav item that leaves this site, so it carries a hairline of its own */
    .mb-in {
      color: var(--text); border: 1px solid var(--line);
      border-radius: 7px; padding: 3px 10px; line-height: 1.5;
    }
    .mb-in:hover { border-color: var(--amber); }
    .mb-theme {
      font-family: var(--mono); font-size: 0.9rem; line-height: 1;
      background: none; border: 0; padding: 0; cursor: pointer;
      color: var(--muted); transition: color 0.18s;
    }
    .mb-theme:hover { color: var(--amber); }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(245, 184, 65, 0.45); }
      70% { box-shadow: 0 0 0 7px rgba(245, 184, 65, 0); }
      100% { box-shadow: 0 0 0 0 rgba(245, 184, 65, 0); }
    }

    /* ---- hero ---- */
    .hero {
      position: relative;
      max-width: var(--wrap); margin: 0 auto;
      padding: clamp(20px, 4vw, 48px) clamp(20px, 5vw, 40px) clamp(40px, 7vw, 88px);
      display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(32px, 5vw, 72px);
      align-items: center;
    }
    /* the owl's eyes: two amber glows watching from the dark */
    .eyes { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
    .eyes span {
      position: absolute; top: 12%; width: 320px; height: 320px; border-radius: 50%;
      background: radial-gradient(circle, rgba(245, 184, 65, 0.16), transparent 62%);
      filter: blur(6px); animation: gaze 7s ease-in-out infinite;
    }
    .eyes span:first-child { left: 30%; }
    .eyes span:last-child { left: 52%; animation-delay: 0.6s; }
    @keyframes gaze { 0%, 100% { opacity: 0.75; } 50% { opacity: 1; } }

    .hero-copy { position: relative; z-index: 1; animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    h1 { font-size: clamp(2.6rem, 6.4vw, 4.6rem); line-height: 0.98; font-weight: 800; }
    .lede {
      color: var(--muted); font-size: 1.06rem; line-height: 1.5;
      max-width: 42ch; margin: 1.2rem 0 1.8rem;
      text-align: justify; text-align-last: left; hyphens: auto;
    }

    /* the download is the whole CTA now, so the buttons carry it: two equal
       widths that stack on narrow screens, note underneath rather than inside */
    .hero-actions { display: flex; gap: 10px; margin-top: 1.8rem; max-width: 440px; flex-wrap: wrap; }
    .hero-actions .btn-dl { flex: 1 1 170px; text-align: center; font-size: 0.86rem; padding: 12px 18px; }
    .dl-hint { font-family: var(--mono); font-size: 0.74rem; color: var(--faint); margin: 10px 0 0; }

    /* ---- panel recreation ---- */
    .panel-wrap { position: relative; z-index: 1; min-width: 0; animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.12s both; }
    .panel {
      /* alias the panel's tokens to the animated props; children fade with them */
      --night-2: var(--p-bg); --line: var(--p-line); --text: var(--p-text);
      --muted: var(--p-muted); --faint: var(--p-faint); --amber: var(--p-amber);
      --sage: var(--p-sage); --clay: var(--p-clay);
      color: var(--text);
      background: var(--p-bg);
      border: 1px solid var(--line);
      border-radius: 18px; padding: 18px;
      box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(245, 184, 65, 0.04);
      max-width: min(360px, 100%); margin-left: auto;
      animation: panelTheme 12s ease-in-out infinite;
    }
    .p-head { display: flex; align-items: baseline; justify-content: space-between; }
    .p-title { font-family: var(--display); font-weight: 700; font-size: 1.05rem; }
    .p-ver { font-family: var(--mono); font-size: 0.66rem; color: var(--faint); font-weight: 400; }
    .p-badge {
      font-family: var(--mono); font-size: 0.6rem; font-weight: 600; letter-spacing: 0.04em;
      color: var(--amber); background: rgba(245, 184, 65, 0.13);
      padding: 3px 8px; border-radius: 20px;
    }
    .p-sub { font-family: var(--mono); font-size: 0.68rem; color: var(--faint); margin-top: 2px; }
    .p-dx {
      font-family: var(--mono); font-size: 0.68rem; font-style: italic;
      color: var(--text); line-height: 1.5; margin: 10px 0 0;
    }
    .p-dx-mark { font-style: normal; }

    .p-row-label { display: flex; align-items: baseline; justify-content: space-between; margin-top: 16px; }
    .p-row-label.mt { margin-top: 18px; }
    .p-row-label span {
      font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--faint);
    }
    .p-row-label b { font-family: var(--mono); font-size: 1.05rem; font-weight: 600; }

    .bar { height: 7px; border-radius: 6px; background: var(--p-track); margin-top: 7px; overflow: hidden; }
    .bar i { display: block; height: 100%; border-radius: 6px; }
    .fill-sage { background: var(--sage); }
    .fill-amber { background: var(--amber); }
    .fill-clay { background: var(--clay); }
    .sage { color: var(--sage); }
    .amber { color: var(--amber); }
    .clay { color: var(--clay); }

    /* Fact rows under a heading: three fixed columns, label left, value hard
       right in each. A row of two leaves the third column empty, which is how
       DRAM read/write clears the memory figure above it. */
    .p-facts {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px 10px;
      margin-top: 7px; font-family: var(--mono); font-size: 0.58rem;
    }
    .p-facts span { display: flex; justify-content: space-between; gap: 6px; }
    .p-facts i { font-style: normal; color: var(--faint); }
    .p-facts b { font-weight: 500; color: var(--muted); }

    /* v1.4: one row per tier — name, a bar per core in it, then that tier's
       usage and average frequency against the right edge. */
    .tier { display: flex; align-items: center; gap: 6px; margin-top: 8px; }
    .tier-k {
      flex: 0 0 74px; font-family: var(--mono); font-size: 0.56rem;
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint);
    }
    .cores { flex: 1; display: flex; gap: 3px; min-width: 0; }
    .core { flex: 1; height: 5px; background: var(--p-track); border-radius: 3px; overflow: hidden; }
    .core i { display: block; height: 100%; border-radius: 3px; }
    .tier-v, .tier-f { font-family: var(--mono); font-size: 0.58rem; text-align: right; }
    .tier-v { flex: 0 0 30px; font-weight: 600; }
    .tier-f { flex: 0 0 48px; color: var(--muted); }

    /* v1.2: memory used bar broken into app / wired / compressed / cached / free */
    .bar-seg { display: flex; }
    .bar-seg i { height: 100%; }
    .seg-app { background: var(--amber); }
    .seg-wired { background: var(--clay); }
    .seg-comp { background: color-mix(in srgb, var(--amber) 55%, var(--p-track)); }
    .seg-cache { background: var(--sage); }
    .mem-legend {
      display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 8px;
      font-family: var(--mono); font-size: 0.56rem; color: var(--faint);
    }
    .mem-legend span { display: inline-flex; align-items: center; gap: 5px; }
    .mem-legend i { width: 7px; height: 7px; border-radius: 2px; }
    .dot-app { background: var(--amber); }
    .dot-wired { background: var(--clay); }
    .dot-comp { background: color-mix(in srgb, var(--amber) 55%, var(--p-track)); }
    .dot-cache { background: var(--sage); }

    .p-apps-head {
      display: flex; justify-content: space-between; margin: 18px 0 4px;
      font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--faint);
    }
    .app {
      display: grid; grid-template-columns: 1fr auto auto auto 18px;
      align-items: center; gap: 10px;
      font-family: var(--mono); font-size: 0.78rem; color: var(--text);
      padding: 5px 6px; border-radius: 6px;
    }
    .app-proc, .app-mem { color: var(--muted); }
    .app-cpu { text-align: right; }
    .app-x { color: var(--muted); cursor: default; text-align: center; }
    .app-x-off { width: 18px; }
    .app.culprit { background: rgba(224, 119, 111, 0.14); }
    .app.culprit .app-name { color: var(--text); }

    /* ---- problem band ---- */
    .band {
      max-width: 820px; margin: 0 auto; text-align: center;
      padding: clamp(56px, 10vw, 120px) clamp(20px, 5vw, 40px);
      border-top: 1px solid var(--line-soft);
    }
    .band h2 { font-size: clamp(1.9rem, 4.6vw, 3.1rem); line-height: 1.05; margin-bottom: 1.4rem; }
    .band-body { color: var(--muted); font-size: 1.1rem; max-width: 60ch; margin: 0 auto; }

    /* ---- demo video (inside the band) ---- */
    .demo-frame {
      margin: clamp(32px, 5vw, 56px) auto 0; max-width: 100%;
      border: 1px solid var(--line); border-radius: 16px; overflow: hidden;
      background: var(--night-2);
      box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(245, 184, 65, 0.04);
    }
    .demo-video { display: block; width: 100%; height: auto; }
    .demo-frame figcaption {
      font-family: var(--mono); font-size: 0.74rem; color: var(--faint);
      padding: 12px; border-top: 1px solid var(--line-soft); background: var(--night-2);
    }

    /* ---- faq ---- */
    .faq { max-width: 760px; margin: 0 auto; padding: clamp(24px, 4vw, 40px) clamp(20px, 5vw, 40px) clamp(48px, 8vw, 88px); }
    .faq-head { text-align: center; margin-bottom: clamp(20px, 3vw, 36px); }
    .faq-item { padding: 20px 0; border-top: 1px solid var(--line-soft); }
    .faq-item:first-child { border-top: 0; }
    .faq-q { font-family: var(--display); font-weight: 700; font-size: 1.06rem; letter-spacing: -0.01em; margin: 0 0 8px; }
    .faq-a { color: var(--muted); font-size: 0.98rem; line-height: 1.6; margin: 0; }

    /* ---- focus statement ---- */
    .focus {
      max-width: 820px; margin: 0 auto; text-align: center;
      padding: clamp(56px, 10vw, 120px) clamp(20px, 5vw, 40px) clamp(24px, 4vw, 40px);
      border-top: 1px solid var(--line-soft);
    }
    .focus p {
      font-family: var(--display); font-weight: 800; letter-spacing: -0.02em;
      font-size: clamp(1.9rem, 4.8vw, 3.2rem); line-height: 1.06; margin: 0;
    }
    /* the statement leads straight into the CTA, so drop the divider between them */
    .focus + .install { border-top: 0; padding-top: clamp(16px, 3vw, 32px); }

    /* ---- features ---- */
    .features { max-width: var(--wrap); margin: 0 auto; padding: clamp(40px, 7vw, 80px) clamp(20px, 5vw, 40px); }
    .sec-head { margin-bottom: clamp(28px, 4vw, 52px); }
    .sec-head h2 { font-size: clamp(1.8rem, 4.2vw, 2.8rem); line-height: 1.05; }
    .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .card {
      position: relative;
      background: var(--card); border: 1px solid var(--line-soft);
      border-radius: 14px; padding: 22px 20px 24px;
      transition: border-color 0.2s, transform 0.2s;
    }
    .card:hover { border-color: var(--line); transform: translateY(-3px); }
    .card h3 {
      font-family: var(--mono); font-size: 0.82rem; font-weight: 600;
      letter-spacing: 0.02em; color: var(--amber); margin-bottom: 10px;
      padding-right: 66px;
    }
    .card p { color: var(--muted); font-size: 0.95rem; line-height: 1.55; margin: 0; }
    .card-arch {
      position: absolute; top: 15px; right: 14px;
      font-family: var(--mono); font-size: 0.5rem; font-weight: 600;
      letter-spacing: 0.06em; text-transform: uppercase;
      padding: 2px 7px; border-radius: 20px; white-space: nowrap;
    }
    .card-arch--all { color: var(--faint); background: rgba(138, 144, 166, 0.12); }
    .card-arch--as  { color: var(--amber); background: rgba(245, 184, 65, 0.13); }

    /* ---- specs ---- */
    .specs {
      max-width: var(--wrap); margin: 0 auto;
      padding: clamp(24px, 4vw, 40px) clamp(20px, 5vw, 40px) clamp(48px, 8vw, 88px);
    }
    .spec-row {
      display: grid; grid-template-columns: repeat(6, 1fr);
      border: 1px solid var(--line-soft); border-radius: 16px; overflow: hidden;
    }
    .spec { padding: 26px 22px; border-right: 1px solid var(--line-soft); }
    .spec:last-child { border-right: 0; }
    .spec-v { font-family: var(--display); font-weight: 700; font-size: 1.35rem; letter-spacing: -0.01em; }
    .spec-l { font-family: var(--mono); font-size: 0.68rem; color: var(--muted); margin-top: 6px; line-height: 1.4; }
    .specs-note { color: var(--faint); font-size: 0.9rem; max-width: 68ch; margin: 22px auto 0; text-align: center; }

    /* ---- install ---- */
    .install {
      max-width: 760px; margin: 0 auto; text-align: center;
      padding: clamp(48px, 8vw, 96px) clamp(20px, 5vw, 40px);
      border-top: 1px solid var(--line-soft);
    }
    .install .sec-head { margin-bottom: 28px; }
    .install .sec-head .eyebrow { text-align: center; }
    .dl-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .btn-dl {
      display: inline-block; font-family: var(--mono); font-size: 0.9rem;
      text-decoration: none; color: var(--night); background: var(--amber);
      border: 1px solid transparent;
      border-radius: 10px; padding: 13px 22px; transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.1s;
    }
    .btn-dl:hover { background: var(--amber-bright); }
    .btn-dl:active { transform: translateY(1px); }
    .dl-ext { font-size: 0.78em; opacity: 0.7; }
    /* Intel is the secondary arch: ghost button so Apple Silicon reads as primary. */
    .btn-dl-alt { background: none; color: var(--text); border-color: var(--line); }
    .btn-dl-alt:hover { background: none; border-color: var(--amber); color: var(--amber); }
    .install-note { color: var(--muted); font-size: 0.98rem; margin: 24px auto 0; max-width: 54ch; }
    .install-note a { color: var(--amber); text-decoration: none; border-bottom: 1px solid rgba(245,184,65,0.3); }
    .install-note b { color: var(--text); font-weight: 600; }

    /* ---- footer ---- */
    .footer {
      max-width: var(--wrap); margin: 0 auto;
      padding: clamp(36px, 6vw, 56px) clamp(20px, 5vw, 40px);
      border-top: 1px solid var(--line-soft);
      display: flex; align-items: flex-start; justify-content: space-between;
      gap: 28px; flex-wrap: wrap;
    }
    .foot-brand { display: flex; gap: 14px; align-items: center; max-width: 380px; }
    .foot-brand img { border-radius: 10px; }
    .foot-name { font-family: var(--display); font-weight: 700; font-size: 1.1rem; }
    .foot-tag { color: var(--faint); font-size: 0.86rem; margin: 3px 0 0; line-height: 1.45; }
    .foot-links { display: flex; gap: 22px; }
    .foot-links a { font-family: var(--mono); font-size: 0.82rem; text-decoration: none; color: var(--muted); transition: color 0.18s; }
    .foot-links a:hover { color: var(--amber); }
    .foot-legal { width: 100%; font-family: var(--mono); font-size: 0.72rem; color: var(--faint); margin: 8px 0 0; }

    @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

    /* ---- responsive ---- */
    @media (max-width: 860px) {
      .hero { grid-template-columns: 1fr; }
      .panel-wrap { order: -1; }
      .panel { margin: 0 auto; }
      .grid { grid-template-columns: repeat(2, 1fr); }
      .spec-row { grid-template-columns: repeat(3, 1fr); }
      .spec:nth-child(3) { border-right: 0; }
      .spec:nth-child(-n+3) { border-bottom: 1px solid var(--line-soft); }
    }
    @media (max-width: 520px) {
      body { font-size: 16px; }
      .mb-read { display: none; }
      /* the two in-page anchors go first on a phone: they only scroll this same
         page, and the hero already carries the download. Sign in cannot go,
         since it is the only way to reach the dashboard at all. */
      .mb-sec { display: none; }
      .grid { grid-template-columns: 1fr; }
      /* stack the download buttons full-width so they don't wrap ragged */
      .dl-row { flex-direction: column; align-items: stretch; }
      .dl-row .btn-dl { text-align: center; }
      .spec-row { grid-template-columns: repeat(2, 1fr); }
      .spec { border-right: 1px solid var(--line-soft); }
      .spec:nth-child(2n) { border-right: 0; }
      .spec:nth-child(-n+4) { border-bottom: 1px solid var(--line-soft); }
      .footer { flex-direction: column; }
    }

    :focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; border-radius: 4px; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto; }
    }
  </style>

  <Analytics />
</body>
</html>
