---
import Dash from '../../layouts/Dash.astro';

export const prerender = false;

// PLACEHOLDER. The key and its activations come from the store's licensing API,
// keyed by the Clerk user. A free account has no key and is told so rather than
// shown a masked one that suggests something is being withheld.
const plan = Astro.url.searchParams.get('plan') === 'pro' ? 'pro' : 'free';
const isPro = plan === 'pro';

const license = {
  key: 'BUBO-4KQ2-9WXM-7T3D-A18F',
  issued: '29 Jul 2026',
  seats: 3,
  machines: [
    { name: "Fajar's MacBook Pro", chip: 'Apple M1 · 8 cores', since: '29 Jul 2026' },
    { name: 'Mac mini (studio)',   chip: 'Apple M2 · 8 cores', since: '29 Jul 2026' },
  ],
};
---

<Dash title="License" active="license" user={{ handle: '@fajarhide', name: 'Fajar Hidayat' }}>
  <div class="work-head">
    <h1>License</h1>
    <p>Your key, and the Macs it is currently running on.</p>
  </div>

  {isPro ? (
    <>
      <section class="card">
        <div class="card-head">
          <div>
            <h2>Bubo Pro</h2>
            <p class="card-sub">Issued {license.issued} · {license.seats} Macs</p>
          </div>
          <span class="badge badge--pro">Pro</span>
        </div>

        <label class="key-label" for="key">License key</label>
        <div class="key">
          <input id="key" class="key-v" value={license.key} readonly spellcheck="false" />
          <button class="btn btn--ghost" type="button" data-copy={license.key}>Copy</button>
        </div>
        <p class="note">
          Paste this into Bubo the first time it opens on a Mac. It stays valid
          offline once activated.
        </p>
      </section>

      <section class="card">
        <div class="card-head">
          <div>
            <h2>Activations</h2>
            <p class="card-sub">
              {license.machines.length} of {license.seats} used. Deactivate a Mac to free its slot.
            </p>
          </div>
        </div>

        <ul class="machines">
          {license.machines.map((m) => (
            <li class="machine">
              <span class="m-name">{m.name}</span>
              <span class="m-chip">{m.chip}</span>
              <span class="m-since">since {m.since}</span>
              <button class="btn btn--danger" type="button">Deactivate</button>
            </li>
          ))}
          {Array.from({ length: license.seats - license.machines.length }).map(() => (
            <li class="machine machine--free"><span class="m-name">Free slot</span></li>
          ))}
        </ul>
      </section>
    </>
  ) : (
    <section class="card">
      <div class="card-head">
        <div>
          <h2>No key on this account</h2>
          <p class="card-sub">Personal needs no licence. A key is only for Pro.</p>
        </div>
        <span class="badge badge--free">Personal</span>
      </div>
      <div class="empty">
        Buying a key issues it here straight away, and the receipt goes to your
        email. Three Macs per key, and you can move a slot whenever you like.
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href="/dashboard">Buy a key</a>
      </div>
    </section>
  )}
</Dash>

<style>
  .key-label {
    display: block; margin-top: 18px; font-size: 0.78rem; color: var(--muted);
  }
  /* the key is an input, not a <code> block: it can be selected, tabbed to and
     read out, and the copy button is the shortcut rather than the only way */
  .key { display: flex; gap: 8px; margin-top: 6px; }
  .key-v {
    flex: 1; min-width: 0; font-family: var(--mono); font-size: 0.92rem;
    letter-spacing: 0.04em; color: var(--text);
    background: var(--night-2); border: 1px solid var(--line);
    border-radius: 10px; padding: 10px 14px; min-height: 44px;
  }

  .machines { list-style: none; margin: 16px 0 0; padding: 0; }
  .machine {
    display: grid; grid-template-columns: 1fr auto auto; align-items: center;
    gap: 2px 14px; padding: 12px 0; border-top: 1px solid var(--line-soft);
  }
  .machine:first-child { border-top: 0; }
  .m-name { font-size: 0.9rem; }
  .m-chip { grid-column: 1; font-family: var(--mono); font-size: 0.74rem; color: var(--muted); }
  .m-since { font-family: var(--mono); font-size: 0.74rem; color: var(--muted); }
  .machine--free { color: var(--muted); font-style: italic; }
  .machine--free .m-name { color: var(--muted); }

  .note { color: var(--muted); font-size: 0.8rem; margin: 12px 0 0; line-height: 1.5; }

  @media (max-width: 560px) {
    .machine { grid-template-columns: 1fr auto; }
    .m-since { display: none; }
  }
</style>
