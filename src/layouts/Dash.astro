---
import '../styles/tokens.css';

// The shell every signed-in page sits in: a top bar and a four-item sidebar.
// Four, not ten. Bubo is one product, and a settings tree deep enough to get
// lost in is a tree nobody reads.
interface Props {
  title: string;
  active: 'home' | 'license' | 'billing' | 'account';
  /** Until Clerk lands, the header identity is passed in rather than read. */
  user?: { handle: string; name: string };
}
const { title, active, user = { handle: '@you', name: 'Signed in' } } = Astro.props;

// Only routes that exist. Billing lands when the store does, since it is a link
// into their portal rather than a page we render, and Account lands with Clerk's
// own <UserProfile />. A nav item that 404s is worse than one that is not there.
const nav = [
  { k: 'home',    label: 'Home',    href: '/dashboard' },
  { k: 'license', label: 'License', href: '/dashboard/license' },
];

const initials = user.name.split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Bubo ID</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <meta name="theme-color" content="#12141F" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#FAF8F3" media="(prefers-color-scheme: light)" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <script is:inline>
    const t = localStorage.getItem('bubo-theme');
    if (t) document.documentElement.style.colorScheme = t;
  </script>
</head>
<body>
  <header class="top">
    <a class="top-brand" href="/">
      <img src="/logo.png" alt="" width="26" height="26" />
      <span>Bubo <b>ID</b></span>
    </a>
    <div class="top-right">
      <button class="top-theme" type="button" aria-label="Toggle light or dark theme">☾</button>
      <button class="who" type="button" aria-haspopup="menu" aria-expanded="false">
        <span class="who-av" aria-hidden="true">{initials}</span>
        <span class="who-id">
          <span class="who-handle">{user.handle}</span>
          <span class="who-name">{user.name}</span>
        </span>
        <span class="who-caret" aria-hidden="true">▾</span>
      </button>
    </div>
  </header>

  <div class="shell">
    <nav class="side" aria-label="Dashboard">
      {nav.map((n) => (
        <a href={n.href} class:list={['side-a', { 'is-on': n.k === active }]}
           aria-current={n.k === active ? 'page' : undefined}>{n.label}</a>
      ))}
      <a class="side-out" href="/">← Back to bubo.weekndlabs.com</a>
    </nav>

    <main class="work">
      <slot />
    </main>
  </div>

  <script>
    // Theme toggle, same contract as the marketing pages: nothing is stored
    // until it is clicked, so the default follows the OS.
    (() => {
      const btn = document.querySelector('.top-theme');
      const media = matchMedia('(prefers-color-scheme: dark)');
      const current = () => localStorage.getItem('bubo-theme') || (media.matches ? 'dark' : 'light');
      const paint = () => { btn.textContent = current() === 'dark' ? '☾' : '☀'; };
      paint();
      media.addEventListener('change', paint);
      btn?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        localStorage.setItem('bubo-theme', next);
        document.documentElement.style.colorScheme = next;
        paint();
      });
    })();

    // Copy buttons report in their own label, so no toast is needed.
    document.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.getAttribute('data-copy') || '');
          const prev = btn.textContent;
          btn.textContent = 'Copied';
          btn.classList.add('is-copied');
          setTimeout(() => { btn.textContent = prev; btn.classList.remove('is-copied'); }, 1600);
        } catch { /* clipboard blocked; the value is selectable on the page */ }
      });
    });
  </script>

  <style is:global>
    /* Dashboard spacing runs tighter than the marketing pages: 8-32px, because
       this is a place to read values, not to be sold to. */
    * { box-sizing: border-box; }
    body {
      margin: 0; background: var(--night); color: var(--text);
      font-family: var(--body); font-size: 15px; line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; }
    h1, h2, h3 { font-family: var(--display); font-weight: 700; letter-spacing: -0.02em; margin: 0; }

    /* ---- top bar ---- */
    .top {
      position: sticky; top: 0; z-index: 20;
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px; height: 56px; padding: 0 16px;
      background: var(--night); border-bottom: 1px solid var(--line-soft);
    }
    .top-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--display); font-size: 0.95rem; }
    .top-brand img { border-radius: 7px; }
    .top-brand b { font-weight: 700; }
    .top-right { display: flex; align-items: center; gap: 8px; }
    .top-theme {
      font-size: 0.95rem; line-height: 1; background: none; border: 0;
      padding: 8px; cursor: pointer; color: var(--muted); border-radius: 8px;
      transition: color 0.18s, background 0.18s;
    }
    .top-theme:hover { color: var(--amber); background: var(--night-2); }

    /* the identity chip: a real menu button, so it looks like one */
    .who {
      display: flex; align-items: center; gap: 10px;
      background: var(--night-2); border: 1px solid var(--line);
      border-radius: 10px; padding: 6px 10px 6px 6px; cursor: pointer;
      color: var(--text); font-family: inherit; text-align: left;
      transition: border-color 0.18s;
    }
    .who:hover { border-color: var(--amber); }
    .who-av {
      display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%;
      background: var(--amber); color: var(--night);
      font-family: var(--mono); font-size: 0.7rem; font-weight: 600;
    }
    .who-id { display: flex; flex-direction: column; line-height: 1.2; }
    .who-handle { font-family: var(--mono); font-size: 0.76rem; }
    .who-name { font-size: 0.7rem; color: var(--muted); }
    .who-caret { color: var(--muted); font-size: 0.7rem; }

    /* ---- shell ---- */
    .shell { display: grid; grid-template-columns: 208px 1fr; align-items: start; }
    .side {
      position: sticky; top: 56px; display: flex; flex-direction: column; gap: 2px;
      padding: 16px 12px; border-right: 1px solid var(--line-soft);
      min-height: calc(100vh - 56px);
    }
    .side-a {
      padding: 8px 12px; border-radius: 8px; text-decoration: none;
      font-size: 0.88rem; color: var(--muted);
      transition: background 0.18s, color 0.18s;
    }
    .side-a:hover { background: var(--night-2); color: var(--text); }
    /* current page carries a filled marker, not just a colour, so it survives
       being read in greyscale */
    .side-a.is-on {
      background: var(--night-2); color: var(--text); font-weight: 600;
      box-shadow: inset 2px 0 0 var(--amber);
    }
    .side-out {
      margin-top: auto; padding: 8px 12px; font-family: var(--mono);
      font-size: 0.72rem; color: var(--faint); text-decoration: none;
    }
    .side-out:hover { color: var(--amber); }

    .work { padding: 32px clamp(16px, 4vw, 40px) 64px; max-width: 900px; }
    .work-head { margin-bottom: 24px; }
    .work-head h1 { font-size: 1.7rem; }
    .work-head p { color: var(--muted); margin: 6px 0 0; font-size: 0.95rem; }

    /* ---- cards ---- */
    .card {
      background: var(--card); border: 1px solid var(--line-soft);
      border-radius: 14px; padding: 20px;
    }
    .card + .card { margin-top: 16px; }
    .card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
    .card h2 { font-size: 1.05rem; }
    .card-sub { color: var(--muted); font-size: 0.86rem; margin: 4px 0 0; }

    /* ---- badges: state, never a control ---- */
    .badge {
      font-family: var(--mono); font-size: 0.62rem; font-weight: 600;
      letter-spacing: 0.08em; text-transform: uppercase;
      padding: 4px 9px; border-radius: 20px; white-space: nowrap;
    }
    .badge--free { color: var(--muted); background: color-mix(in srgb, var(--muted) 14%, transparent); }
    .badge--pro { color: var(--amber); background: color-mix(in srgb, var(--amber) 15%, transparent); }
    .badge--ok { color: var(--sage); background: color-mix(in srgb, var(--sage) 15%, transparent); }

    /* ---- buttons ---- */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      min-height: 40px; padding: 9px 16px; border-radius: 10px;
      font-family: var(--mono); font-size: 0.82rem; text-decoration: none;
      border: 1px solid transparent; cursor: pointer;
      transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.1s;
    }
    .btn:active { transform: translateY(1px); }
    .btn--primary { background: var(--amber); color: var(--night); }
    .btn--primary:hover { background: var(--amber-bright); }
    .btn--ghost { border-color: var(--line); color: var(--text); background: none; }
    .btn--ghost:hover { border-color: var(--amber); color: var(--amber); }
    .btn--danger { border-color: var(--line); color: var(--clay); background: none; }
    .btn--danger:hover { border-color: var(--clay); }
    .btn.is-copied { background: var(--sage); color: var(--night); border-color: transparent; }
    .btn-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }

    /* ---- key/value rows ---- */
    .kv { display: grid; grid-template-columns: 150px 1fr; gap: 8px 16px; margin-top: 16px; font-size: 0.88rem; }
    .kv dt { color: var(--muted); }
    .kv dd { margin: 0; font-family: var(--mono); font-size: 0.84rem; }

    .empty {
      border: 1px dashed var(--line); border-radius: 12px;
      padding: 24px; text-align: center; color: var(--muted); font-size: 0.9rem;
    }

    :focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; border-radius: 6px; }

    @media (max-width: 760px) {
      .shell { grid-template-columns: 1fr; }
      .side {
        position: static; min-height: 0; flex-direction: row; overflow-x: auto;
        border-right: 0; border-bottom: 1px solid var(--line-soft); padding: 8px 12px;
      }
      .side-a.is-on { box-shadow: inset 0 -2px 0 var(--amber); }
      .side-out { display: none; }
      .who-id { display: none; }
      .kv { grid-template-columns: 1fr; gap: 2px 0; }
      .kv dd { margin-bottom: 10px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { transition: none !important; animation: none !important; }
    }
  </style>
</body>
</html>
